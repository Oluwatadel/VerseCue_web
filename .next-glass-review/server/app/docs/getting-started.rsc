0:["FvauCzJK0e5DDiw7njKb6",[[["",{"children":["(site)",{"children":["docs",{"children":[["slug","getting-started","d"],{"children":["__PAGE__?{\"slug\":\"getting-started\"}",{}]}]}]}]},"$undefined","$undefined",true],["",{"children":["(site)",{"children":["docs",{"children":[["slug","getting-started","d"],{"children":["__PAGE__",{},[["$L1",["$","article",null,{"className":"container-x py-14 sm:py-20","children":[["$","$L2",null,{"href":"/docs","className":"text-sm text-blue-700","children":"← All guides"}],["$","h1",null,{"className":"page-title","children":"Getting started"}],["$","p",null,{"className":"page-intro","children":"Prepare your computer, microphone, Bible files and projection screen."}],["$","div",null,{"className":"mt-9 max-w-4xl space-y-6","children":[["$","section","Install and prepare",{"className":"glass rounded-xl p-6 sm:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold","children":"Install and prepare"}],["$","ol",null,{"className":"mt-5 list-decimal space-y-4 pl-5 text-slate-700","children":[["$","li","For smooth live AI use, start with Windows 11 x64, a modern 4–6 core CPU, 16 GB RAM and an SSD with 15 GB free. Use 32 GB RAM when combining heavy video and streaming. The download page has the full recommended specifications. These are planning recommendations, not guaranteed timing benchmarks.",{"className":"pl-2 leading-7","children":"For smooth live AI use, start with Windows 11 x64, a modern 4–6 core CPU, 16 GB RAM and an SSD with 15 GB free. Use 32 GB RAM when combining heavy video and streaming. The download page has the full recommended specifications. These are planning recommendations, not guaranteed timing benchmarks."}],["$","li","Create a free account with your email, organisation name and password. Sign in to download the Windows installer once published, complete setup, then sign into VerseCue with the same account.",{"className":"pl-2 leading-7","children":"Create a free account with your email, organisation name and password. Sign in to download the Windows installer once published, complete setup, then sign into VerseCue with the same account."}],["$","li","Your signed-in free account includes Bible lookup, projection, songs, slides and video. No activation code is needed for these tools. For AI transcription and automatic verse detection, choose a plan under Account → Plans & billing. After verified payment or an admin account grant, keep VerseCue open and signed in with the same account. Choose Check activation now in the desktop app or Activate in desktop app on the website. Access syncs online without activation keys. Computer limits still apply. Offline AI access lasts up to 72 hours by default; free features keep working after expiry.",{"className":"pl-2 leading-7","children":"Your signed-in free account includes Bible lookup, projection, songs, slides and video. No activation code is needed for these tools. For AI transcription and automatic verse detection, choose a plan under Account → Plans & billing. After verified payment or an admin account grant, keep VerseCue open and signed in with the same account. Choose Check activation now in the desktop app or Activate in desktop app on the website. Access syncs online without activation keys. Computer limits still apply. Offline AI access lasts up to 72 hours by default; free features keep working after expiry."}],["$","li","Import Bible files in a supported XML or JSON format that you have permission to use. Keep your original files backed up.",{"className":"pl-2 leading-7","children":"Import Bible files in a supported XML or JSON format that you have permission to use. Keep your original files backed up."}],["$","li","Open Preferences, choose the default translation, and click Save at the bottom. Settings stay pending until saved.",{"className":"pl-2 leading-7","children":"Open Preferences, choose the default translation, and click Save at the bottom. Settings stay pending until saved."}]]}]]}],["$","section","Rehearse the service workflow",{"className":"glass rounded-xl p-6 sm:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold","children":"Rehearse the service workflow"}],["$","ol",null,{"className":"mt-5 list-decimal space-y-4 pl-5 text-slate-700","children":[["$","li","For an AI rehearsal, activate on the website and sign in from VerseCue first. Select your recording device on the dashboard and use the included VerseCue Clarity default. You can rehearse manual Bible lookup and media without activation.",{"className":"pl-2 leading-7","children":"For an AI rehearsal, activate on the website and sign in from VerseCue first. Select your recording device on the dashboard and use the included VerseCue Clarity default. You can rehearse manual Bible lookup and media without activation."}],["$","li","Click Start Mic and speak a clear reference, such as John chapter three, verse sixteen. Verify the transcript and suggested reference.",{"className":"pl-2 leading-7","children":"Click Start Mic and speak a clear reference, such as John chapter three, verse sixteen. Verify the transcript and suggested reference."}],["$","li","Click a recent detection once to preview it. Double-click it or use Display only when ready to put it on the projection screen.",{"className":"pl-2 leading-7","children":"Click a recent detection once to preview it. Double-click it or use Display only when ready to put it on the projection screen."}],["$","li","Use Go Live to open the projection window on your chosen display. Test this before the congregation arrives.",{"className":"pl-2 leading-7","children":"Use Go Live to open the projection window on your chosen display. Test this before the congregation arrives."}]]}]]}],["$","section","Learn the essentials",{"className":"glass rounded-xl p-6 sm:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold","children":"Learn the essentials"}],["$","ol",null,{"className":"mt-5 list-decimal space-y-4 pl-5 text-slate-700","children":[["$"