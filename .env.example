# Set after the Windows installer is published. HTTPS installer/release URL only.
WINDOWS_DOWNLOAD_URL=

# Official public support contact, when ready.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Canonical public site URL for metadata.
NEXT_PUBLIC_SITE_URL=https://verse-cue-web.vercel.app

# PostgreSQL accounts/licensing and existing historical waitlist data.
DATABASE_URL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_ or bundle them in desktop builds.
# PEM can contain actual newlines or escaped \n sequences; use a secure deployment secret store.
ACTIVATION_PRIVATE_KEY_PEM=
MODEL_CONTENT_KEY_BASE64=
MODEL_KEY_ID=
# 1–168 hours; default signed offline grace is 72 hours.
ACTIVATION_OFFLINE_HOURS=72

# Paystack hosted checkout; never expose this secret to the browser or desktop.
PAYSTACK_SECRET_KEY=
# Optional recurring plans: create in Paystack with these exact NGN prices/intervals.
# Monthly: 600000 kobo/monthly; six months: 3300000 kobo/biannually; annual: 6000000 kobo/annually.
PAYSTACK_PLAN_MONTHLY=
PAYSTACK_PLAN_SIX_MONTHS=
PAYSTACK_PLAN_ANNUAL=
# Allows hosted Paystack test checkout with sk_test_ keys. Test receipts do not unlock live AI.
BILLING_ALLOW_TEST_CHECKOUT=0
# Allows sandbox grants only outside NODE_ENV=production. Never enable for live use.
BILLING_ALLOW_TEST_ACTIVATION=0
# Resend transactional email (free tier quotas apply). Use a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# At least 32 random characters; authenticate the scheduled /api/jobs/daily request.
CRON_SECRET=

# Optional: private storage for consented speech-test recordings. Never NEXT_PUBLIC_.
# Timing/transcript reports work without this; audio remains disabled until configured.
TEST_AUDIO_BUCKET=
TEST_AUDIO_REGION=
TEST_AUDIO_ENDPOINT=
TEST_AUDIO_ACCESS_KEY_ID=
TEST_AUDIO_SECRET_ACCESS_KEY=
TEST_AUDIO_PATH_STYLE=0

# Server-side Android installer origin; free website sign-in is required for protected downloads.
MOBILE_ANDROID_DOWNLOAD_URL=

# Public, signed GitHub release feeds. Leave empty until the signed assets are published.
# No activation, payment or private update signing keys are required by these endpoints.
DESKTOP_UPDATE_MANIFEST_URL=
MOBILE_UPDATE_INDEX_URL=

# Protected download gateway (see DOWNLOAD-GATEWAY-AND-ANALYTICS.md).
# HTTPS Worker origin with trailing slash, e.g. https://downloads.example.com/
DOWNLOAD_GATEWAY_URL=
# New random secret >=32 characters, identical in Vercel and the download Worker.
# This is NOT an activation, model-content or update-publisher key.
DOWNLOAD_GATEWAY_SECRET=
# Optional release marker for origins without ETag / Last-Modified headers.
MOBILE_RELEASE_ID=
DESKTOP_PUBLIC_VERSION=1.0.0
MOBILE_PUBLIC_VERSION=1.0.0

# Private destination for new complaints and customer replies (not the sender address).
SUPPORT_NOTIFICATION_EMAIL=
