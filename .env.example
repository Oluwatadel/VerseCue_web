# Set after the Windows installer is published. HTTPS installer/release URL only.
WINDOWS_DOWNLOAD_URL=

# Official public support contact, when ready.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Canonical public site URL for metadata.
NEXT_PUBLIC_SITE_URL=https://versecue.app

# PostgreSQL accounts/licensing and existing historical waitlist data.
DATABASE_URL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_ or bundle them in desktop builds.
# PEM can contain actual newlines or escaped \n sequences; use a secure deployment secret store.
ACTIVATION_PRIVATE_KEY_PEM=
MODEL_CONTENT_KEY_BASE64=
MODEL_KEY_ID=
# 1–168 hours; default signed offline grace is 72 hours.
ACTIVATION_OFFLINE_HOURS=72

# Paystack hosted checkout; never expose this secret to the browser or desktop.
PAYSTACK_SECRET_KEY=
# Optional recurring plans: create in Paystack with these exact NGN prices/intervals.
# Monthly: 600000 kobo/monthly; six months: 3300000 kobo/biannually; annual: 6000000 kobo/annually.
PAYSTACK_PLAN_MONTHLY=
PAYSTACK_PLAN_SIX_MONTHS=
PAYSTACK_PLAN_ANNUAL=
# Allows sandbox grants only outside NODE_ENV=production. Never enable for live use.
BILLING_ALLOW_TEST_ACTIVATION=0
# Resend transactional email (free tier quotas apply). Use a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# At least 32 random characters; authenticate the scheduled /api/jobs/daily request.
CRON_SECRET=
