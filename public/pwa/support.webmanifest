{
  "id": "/pwa/support",
  "name": "verseVIO Support",
  "short_name": "verseVIO Support",
  "description": "Track complaints and talk to the verseVIO support team.",
  "lang": "en",
  "start_url": "/account/support",
  "scope": "/account",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#102039",
  "theme_color": "#102039",
  "icons": [
    {
      "src": "/pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Support requests",
      "url": "/account/support"
    }
  ]
}
