{
  "id": "/pwa/admin",
  "name": "verseVIO Admin",
  "short_name": "verseVIO Admin",
  "description": "Manage support tickets, accounts, payments and analytics.",
  "lang": "en",
  "start_url": "/admin/support",
  "scope": "/admin",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#102039",
  "theme_color": "#102039",
  "icons": [
    {
      "src": "/pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Support requests",
      "url": "/admin/support"
    }
  ]
}
